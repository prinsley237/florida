{"id":1104,"date":"2020-03-31T09:07:29","date_gmt":"2020-03-31T14:07:29","guid":{"rendered":"https:\/\/www.floridapoodlerescue.org\/?page_id=1104"},"modified":"2020-05-26T13:15:29","modified_gmt":"2020-05-26T18:15:29","slug":"volunteer-application","status":"publish","type":"page","link":"https:\/\/www.floridapoodlerescue.org\/volunteer-application\/","title":{"rendered":"Volunteer Application"},"content":{"rendered":"<p>[et_pb_section fb_built=&#8221;1&#8243; admin_label=&#8221;Listings&#8221; _builder_version=&#8221;3.22&#8243; custom_padding=&#8221;40px||0||false|false&#8221; animation_style=&#8221;fade&#8221; animation_delay=&#8221;200ms&#8221;][et_pb_row _builder_version=&#8221;3.25&#8243;][et_pb_column type=&#8221;4_4&#8243; _builder_version=&#8221;3.25&#8243; custom_padding=&#8221;|||&#8221; custom_padding__hover=&#8221;|||&#8221;][et_pb_text _builder_version=&#8221;3.27.4&#8243;]\n<!-- This file should primarily consist of HTML with a little bit of PHP. -->\n<div class=\"card shadow mb-3 mx-auto\">\n    <div id=\"application-card-header\" class=\"card-header bg-info text-white text-center\">\n        Volunteer Application Form\n        <button id=\"volunteer-reset-btn\" class=\"btn btn-light btn-sm rounded-0 float-right small\" style=\"font-family: inherit;\" type=\"button\">Reset<\/button>\n    <\/div>\n    <div id=\"application-card-body\" class=\"card-body small bg-light\">\n        <div id=\"application-form\">\n            <h3>Your Information<\/h3>\n            <form id=\"fpr-volunteer-application-form\">                \n                <section>\n                    <div class=\"form-feild-row row\">\n                       \n                        <div class=\"col-sm-6 form-group\">\n                            <label for=\"firstName\">First Name*:  <\/label>\n                            <input type=\"text\" maxlength=\"50\" id=\"firstName\" name=\"firstName\" data-validation=\"required\">\n                        <\/div>\n                        <div class=\"col-sm-6 form-group\">\n                            <label for=\"lastName\">Last Name*:<\/label>\n                            <input type=\"text\" maxlength=\"50\" id=\"lastName\" name=\"lastName\" data-validation=\"required\">\n                        <\/div>\n                        \n                        \n                        <div class=\"col-sm-6 form-group\">\n                            <label for=\"phoneNumber2\">Phone: <span style=\"font-size: 70%;\">(preferably a cell phone number with ability to send and receive text messages)<\/span><\/label>\n                            <input type=\"tel\" maxlength=\"20\" id=\"phoneNumber2\" name=\"phoneNumber2\" placeholder=\"Valid US Phone Number\"  data-validation=\"custom\" data-validation-regexp=\"^(1\\s?)?((\\([0-9]{3}\\))|[0-9]{3})[\\s\\-]?[\\0-9]{3}[\\s\\-]?[0-9]{4}$\">\n                        <\/div>\n                        <div class=\"col-sm-6 form-group\">\n                           <label for=\"email\">Email Address*:<\/label>\n                            <input type=\"email\" maxlength=\"250\" id=\"email\" name=\"email\" data-validation=\"email\">\n                        <\/div>\n\t\t\t\t\t\t                        <div class=\"col-sm-12\">\n                            <label for=\"address1\">Street Address*:<\/label>\n                            <input type=\"text\" maxlength=\"250\" id=\"address1\" name=\"address1\" data-validation=\"required\">\n                        <\/div>\n                \n                        <div class=\"col-sm-3\">\n                            <label for=\"county\">County*:<\/label>\n                            <input type=\"text\" maxlength=\"50\" id=\"county\" name=\"county\" data-validation=\"required\">\n                        <\/div>\n                       \n                        <div class=\"col-sm-3\">\n                            <label for=\"city\">City*:<\/label>\n                            <input type=\"text\" maxlength=\"50\" id=\"city\" name=\"city\" data-validation=\"required\">\n                        <\/div>\n                       \n                        <div class=\"col-sm-3\">\n                            <label for=\"state\">State*:<\/label>\n                            <select  id=\"state\" name=\"state\" data-validation=\"required\">\n                                <option><\/option>\n                                                                    <option value=\"AL\">ALABAMA<\/option>\n                                                                        <option value=\"AK\">ALASKA<\/option>\n                                                                        <option value=\"AS\">AMERICAN SAMOA<\/option>\n                                                                        <option value=\"AZ\">ARIZONA<\/option>\n                                                                        <option value=\"AR\">ARKANSAS<\/option>\n                                                                        <option value=\"CA\">CALIFORNIA<\/option>\n                                                                        <option value=\"CO\">COLORADO<\/option>\n                                                                        <option value=\"CT\">CONNECTICUT<\/option>\n                                                                        <option value=\"DE\">DELAWARE<\/option>\n                                                                        <option value=\"DC\">DISTRICT OF COLUMBIA<\/option>\n                                                                        <option value=\"FM\">FEDERATED STATES OF MICRONESIA<\/option>\n                                                                        <option value=\"FL\">FLORIDA<\/option>\n                                                                        <option value=\"GA\">GEORGIA<\/option>\n                                                                        <option value=\"GU\">GUAM GU<\/option>\n                                                                        <option value=\"HI\">HAWAII<\/option>\n                                                                        <option value=\"ID\">IDAHO<\/option>\n                                                                        <option value=\"IL\">ILLINOIS<\/option>\n                                                                        <option value=\"IN\">INDIANA<\/option>\n                                                                        <option value=\"IA\">IOWA<\/option>\n                                                                        <option value=\"KS\">KANSAS<\/option>\n                                                                        <option value=\"KY\">KENTUCKY<\/option>\n                                                                        <option value=\"LA\">LOUISIANA<\/option>\n                                                                        <option value=\"ME\">MAINE<\/option>\n                                                                        <option value=\"MH\">MARSHALL ISLANDS<\/option>\n                                                                        <option value=\"MD\">MARYLAND<\/option>\n                                                                        <option value=\"MA\">MASSACHUSETTS<\/option>\n                                                                        <option value=\"MI\">MICHIGAN<\/option>\n                                                                        <option value=\"MN\">MINNESOTA<\/option>\n                                                                        <option value=\"MS\">MISSISSIPPI<\/option>\n                                                                        <option value=\"MO\">MISSOURI<\/option>\n                                                                        <option value=\"MT\">MONTANA<\/option>\n                                                                        <option value=\"NE\">NEBRASKA<\/option>\n                                                                        <option value=\"NV\">NEVADA<\/option>\n                                                                        <option value=\"NH\">NEW HAMPSHIRE<\/option>\n                                                                        <option value=\"NJ\">NEW JERSEY<\/option>\n                                                                        <option value=\"NM\">NEW MEXICO<\/option>\n                                                                        <option value=\"NY\">NEW YORK<\/option>\n                                                                        <option value=\"NC\">NORTH CAROLINA<\/option>\n                                                                        <option value=\"ND\">NORTH DAKOTA<\/option>\n                                                                        <option value=\"MP\">NORTHERN MARIANA ISLANDS<\/option>\n                                                                        <option value=\"OH\">OHIO<\/option>\n                                                                        <option value=\"OK\">OKLAHOMA<\/option>\n                                                                        <option value=\"OR\">OREGON<\/option>\n                                                                        <option value=\"PW\">PALAU<\/option>\n                                                                        <option value=\"PA\">PENNSYLVANIA<\/option>\n                                                                        <option value=\"PR\">PUERTO RICO<\/option>\n                                                                        <option value=\"RI\">RHODE ISLAND<\/option>\n                                                                        <option value=\"SC\">SOUTH CAROLINA<\/option>\n                                                                        <option value=\"SD\">SOUTH DAKOTA<\/option>\n                                                                        <option value=\"TN\">TENNESSEE<\/option>\n                                                                        <option value=\"TX\">TEXAS<\/option>\n                                                                        <option value=\"UT\">UTAH<\/option>\n                                                                        <option value=\"VT\">VERMONT<\/option>\n                                                                        <option value=\"VI\">VIRGIN ISLANDS<\/option>\n                                                                        <option value=\"VA\">VIRGINIA<\/option>\n                                                                        <option value=\"WA\">WASHINGTON<\/option>\n                                                                        <option value=\"WV\">WEST VIRGINIA<\/option>\n                                                                        <option value=\"WI\">WISCONSIN<\/option>\n                                                                        <option value=\"WY\">WYOMING<\/option>\n                                                                        <option value=\"AE\">ARMED FORCES AFRICA \\ CANADA \\ EUROPE \\ MIDDLE EAST<\/option>\n                                                                        <option value=\"AA\">ARMED FORCES AMERICA (EXCEPT CANADA)<\/option>\n                                                                        <option value=\"AP\">ARMED FORCES PACIFIC<\/option>\n                                                                <\/select>\n                        <\/div>\n                       \n                        <div class=\"col-sm-3\">\n                            <label for=\"zip\">Zip*:<\/label>\n                            <input type=\"text\" maxlength=\"20\" id=\"zip\" name=\"zip\" data-validation=\"custom\" data-validation-regexp=\"^[0-9]{5}$\">\n                        <\/div>\n\n                    <\/div>\n                    <!--\/.form-feild-row-->\n                <\/section>  \n                \n                <section>           \n                    <div class=\"form-group form-feild-row row\">\n                       \n                        <div class=\"col-sm-6 form-group\">\n                            <label for=\"age\">Age*:<\/label>\n                            <input type=\"text\" maxlength=\"3\" id=\"age\" name=\"age\" data-validation=\"number,required\" data-validation-length=\"max3\">\n                        <\/div>\n                        \n                        <div class=\"col-sm-6 form-group\">\n                            <label for=\"occupation\">Occupation*:<\/label>\n                            <input type=\"text\" maxlength=\"50\" id=\"occupation\" name=\"occupation\" data-validation=\"required\">\n                        <\/div>\n                    <\/div>\n                     <!--\/.form-feild-row-->\n\n                <\/section>          \n\n                <section>           \n\n                   <div class=\"form-group form-feild-row row\">\n                       \n                        <div class=\"col-sm-6 form-group\">\n                            <label for=\"specialSkills\" >Do you have any special skills that you would like to use to help FPR (e.g. writing, grooming, Google Docs, QuickBooks, event planning, grant writing, Wordpress for Websites, Excel, etc)?*  <\/label>                           \n                            <textarea  id=\"specialSkills\" name=\"specialSkills\" data-validation=\"required\"><\/textarea>\n                        <\/div>\n                        \n                        <div class=\"col-sm-6 form-group\">\n                           <label for=\"volunteerBefore\">Have you ever volunteered with a rescue or shelter before?*   <\/label>\n                            <div class=\"form-check form-check-inline\"><input type=\"radio\" name=\"volunteerBefore\" value=\"Yes\"  data-validation=\"required\"\/>Yes<\/div>\n                            <div class=\"form-check form-check-inline\"><input type=\"radio\" name=\"volunteerBefore\" value=\"No\" \/> No<\/div>\n                        <\/div>\n                        \n                        <div class=\"col-sm-12\">\n                           <label >Areas of interest*: <span id=\"areainterestformerror\" class=\"help-block form-error\"><\/span><\/label>\n                            <div class=\"row\">\n                            \t<div class=\"col-sm-4\">\n                                    <div class=\"form-check\">\n                                        <input class=\"form-check-input areainterest\" type=\"checkbox\" value=\"Placement\" id=\"areasInterestPlacement\" name=\"areasInterestPlacement\">\n                                      Placement\n                                    <\/div>\n                                <\/div>\n                                <div class=\"col-sm-4\">\n                                    <div class=\"form-check\">\n                                        <input class=\"form-check-input areainterest\" type=\"checkbox\" id=\"areasInterestIntake\" value=\"Intake\" name=\"areasInterestIntake\">\n                                       Intake and Medical Records \n                                    <\/div>                  \n                                <\/div>\n                                <div class=\"col-sm-4\">\n                                    <div class=\"form-check\">\n                                        <input class=\"form-check-input areainterest\" type=\"checkbox\" id=\"areasInterestPhoneEmail\" value=\"Telephone and email inquiries\" name=\"areasInterestPhoneEmail\">\n                                        Telephone and Email Inquiries \n                                    <\/div>\n                                <\/div>\n                                <div class=\"col-sm-4\">\n                                    <div class=\"form-check\">\n                                        <input class=\"form-check-input areainterest\" type=\"checkbox\" id=\"areasInterestIApplctn\" value=\"Application reference checking\" name=\"areasInterestIApplctn\">\n                                        Application Reference Checking  \n                                    <\/div>                  \n                                <\/div>\n                                <div class=\"col-sm-4\">\n                                    <div class=\"form-check\">\n                                        <input class=\"form-check-input areainterest\" type=\"checkbox\" value=\"Office and administrative\" id=\"areasInterestOfficeAdmin\" name=\"areasInterestOfficeAdmin\">\n                                        Bookkeeping and Administrative \n                                    <\/div>\n                                <\/div>\n                                <div class=\"col-sm-4\">\n                                    <div class=\"form-check\">\n                                        <input class=\"form-check-input areainterest\" type=\"checkbox\" value=\"Homevisits\" id=\"areasInterestHomevisits\" name=\"areasInterestHomevisits\">\n                                      Home Visits\n                                    <\/div>\n                                <\/div>\n                                <div class=\"col-sm-4\">\n                                    <div class=\"form-check\">\n                                        <input class=\"form-check-input areainterest\" type=\"checkbox\" value=\"Newsletter\" id=\"areasInterestNewsletter\" name=\"areasInterestNewsletter\">\n                                      Newsletter Preparation and Editing\n                                    <\/div>\n                                <\/div>\n                                <div class=\"col-sm-4\">\n                                    <div class=\"form-check\">\n                                        <input class=\"form-check-input areainterest\" type=\"checkbox\" value=\"Socialmedia\" id=\"areasInterestSocialmedia\" name=\"areasInterestSocialmedia\">\n                                      Facebook and Social Media\n                                    <\/div>\n                                <\/div>\n                                <div class=\"col-sm-4\">\n                                    <div class=\"form-check\">\n                                        <input class=\"form-check-input areainterest\" type=\"checkbox\" value=\"WSAdmin\" id=\"areasInterestWSAdmin\" name=\"areasInterestWSAdmin\">\n                                      Website Admin with Wordpress\n                                    <\/div>\n                                <\/div>\n                                <div class=\"col-sm-4\">\n                                    <div class=\"form-check\">\n                                        <input class=\"form-check-input areainterest\" type=\"checkbox\" value=\"Special events and fundraising\" id=\"areasInterestEventFundRais\" name=\"areasInterestEventFundRais\">\n                                        Special Events and Fundraising \n                                    <\/div>\n                                <\/div>\n                            <\/div><!-- row -->\n                        <\/div><!-- col-sm-12 -->\n                        <div class=\"col-sm-12\">\n                            <div class=\"row\">\n                            \n                                <div class=\"col-sm-6\">\n                                    <div class=\"form-check\">\n                                        <div>\n                                        \t<input class=\"form-check-input areainterest\" type=\"checkbox\" id=\"areasInterestTransportaion\" value=\"Transportation\"  name=\"areasInterestTransportaion\">\n                                        <\/div>\n                                        <div >\n                                        Dog Transport \n                                            <div style=\"line-height: 12px;\">\n                                            <span style=\"font-size: 70%;\">List type of vehicle and the region where you can transport (e.g. south Florida, north Florida, east coast or west coast Florida)<\/span><\/div>\n                                        \t<textarea  id=\"areasOfInterestTransportList\" name=\"areasOfInterestTransportList\"><\/textarea> \n                                        <\/div>\n                                    <\/div>\n                                <\/div>\n                                <div class=\"col-sm-6 form-group\">\n                                    <div class=\"form-check\">\n                                    \t<input class=\"form-check-input areainterest\" type=\"checkbox\" value=\"Other\" id=\"areasInterestOther\" name=\"areasInterestOther\">\n                                    \tOther\n                                    <\/div>\n                                    <div class=\"form-check\" style=\"display: block;\" id=\"other-intrests\">\n                                    \t<label for=\"areasOfInterestOtherList\">List Other Areas of Interest:<\/label>                            \n                                    \t<textarea  id=\"areasOfInterestOtherList\" name=\"areasOfInterestOtherList\"><\/textarea>\n                                    <\/div>\n                                <\/div>\n                            <\/div><!-- row -->\n                        <\/div><!-- col-sm-12 --> \n                   \t\t<br>\n                        <div class=\"col-sm-6 form-group\">\n                            <label for=\"hoursToDevote\" >How many hours per week approximately do you plan to devote to volunteering with us?* <\/label>\n                            <input type=\"text\" maxlength=\"50\" id=\"hoursToDevote\" name=\"hoursToDevote\" data-validation=\"required\">\n                        <\/div>\n                        <div class=\"col-sm-6 form-group\">\n                            <label for=\"volunteerInFlorida\" >If you are a seasonal Florida resident, are you only available to volunteer while you are in Florida?  <\/label>\n                            <input type=\"text\" maxlength=\"50\" id=\"volunteerInFlorida\" name=\"volunteerInFlorida\">\n                        <\/div>\n                    <\/div> <!--\/.form-feild-row-->\n\n                <\/section>  \n\n                <h3>Personal References<\/h3>\n\n                <section>            \n                    <div class=\"mb-5\">\n                        <span>\n                            Please provide the contact information for two friends or colleagues who are not related to you. People with whom you have worked or volunteered make the best references. Including email addresses will speed processing of your application.\n                        <\/span>\n                    <\/div>\n                    <div class=\"row\">\n                        <div class=\"col-sm-6 form-group\">\n                            <legend class=\"text-info\">Reference #1<\/legend>\n                            <div class=\"form-group form-feild-row row\">\n                               \n                                <div class=\"col-sm-12\">\n                                    <label for=\"refName1\" >Name*: <\/label>\n                                    <input type=\"text\" maxlength=\"150\" id=\"refName1\" name=\"refName1\" data-validation=\"required\">\n                                <\/div>\n\n                                <div class=\"col-sm-12\">\n                                   <label for=\"refEmail1\" >Email Address:<\/label>\n                                    <input type=\"email\" maxlength=\"250\" id=\"refEmail1\" name=\"refEmail1\" data-validation=\"custom\" data-validation-regexp=\"^[a-zA-Z0-9.!#$%&'*+\/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*$|^$\">\n                                <\/div>\n                               \n                                <div class=\"col-sm-12\">\n                                    <label for=\"refPhone1\" >Phone*: <span style=\"font-size: 70%;\">(preferably a cell phone number with ability to send and receive text messages)<\/span><\/label>\n                                    <input type=\"tel\" maxlength=\"20\" id=\"refPhone1\" name=\"refPhone1\" placeholder=\"Valid US Phone Number\"  data-validation=\"custom\" data-validation-regexp=\"^(1\\s?)?((\\([0-9]{3}\\))|[0-9]{3})[\\s\\-]?[\\0-9]{3}[\\s\\-]?[0-9]{4}$\">\n                                <\/div>\n\n                                <div class=\"col-sm-12\">\n                                   <label for=\"refRelationship1\" >Relationship to You*:<\/label>\n                                    <input type=\"text\" maxlength=\"250\" id=\"refRelationship1\" name=\"refRelationship1\" data-validation=\"required\">\n                                <\/div>\n                            <\/div>\n                        <\/div>\n                        <div class=\"col-sm-6 form-group\">\n                            <legend class=\"text-info\">Reference #2<\/legend>\n                             <div class=\"form-group form-feild-row row\">\n                               \n                                <div class=\"col-sm-12\">\n                                    <label for=\"refName2\" >Name*: <\/label>\n                                    <input type=\"text\" maxlength=\"150\" id=\"refName2\" name=\"refName2\" data-validation=\"required\">\n                                <\/div>\n\n                                <div class=\"col-sm-12\">\n                                   <label for=\"refEmail2\" >Email Address:<\/label>\n                                    <input type=\"email\" maxlength=\"250\" id=\"refEmail2\" name=\"refEmail2\" data-validation=\"custom\" data-validation-regexp=\"^[a-zA-Z0-9.!#$%&'*+\\\/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$|^$\">\n                                <\/div>\n\n                                <div class=\"col-sm-12\">\n                                    <label for=\"refPhone2\" >Phone*: <span style=\"font-size: 70%;\">(preferably a cell phone number with ability to send and receive text messages)<\/span> <\/label>\n                                    <input type=\"tel\" maxlength=\"20\" id=\"refPhone2\" name=\"refPhone2\" placeholder=\"Valid US Phone Number\"  data-validation=\"custom\" data-validation-regexp=\"^(1\\s?)?((\\([0-9]{3}\\))|[0-9]{3})[\\s\\-]?[\\0-9]{3}[\\s\\-]?[0-9]{4}$\">\n                                <\/div>\n\n                                <div class=\"col-sm-12\">\n                                    <label for=\"refRelationship2\" >Relationship to You*:<\/label>\n                                    <input type=\"text\" maxlength=\"250\" id=\"refRelationship2\" name=\"refRelationship2\" data-validation=\"required\">\n                                <\/div>\n                            <\/div>\n                        <\/div>\n                    <\/div>\n\n                    <div class=\"form-group form-feild-row row\">\n                        <div class=\"col-sm-12\">\n                            <div class=\"form-check\">\n                                <input class=\"form-check-input\" type=\"checkbox\" name=\"miscQuestions24\" data-validation=\"required\">\n                                <span class=\"font-weight-bold\">\n                                    I have carefully read the information on volunteering. This is my digital signature authorizing you to consider me as a potential volunteer for Florida Poodle Rescue.\n                                <\/span>\n                            <\/div>\n                        <\/div>\n                        <div class=\"col-sm-12\"> <div class=\"form-submit\"><input type=\"submit\" value=\"submit\"\/> <\/div><\/div>\n                    <\/div>\n    